#!/bin/zsh
# Thin client for AgentCurtain.app. It never creates an event tap and needs no TCC permission.
set -eu

state_dir=$HOME/.local/state/curtain
config_dir=$HOME/.config/curtain
socket_path=$state_dir/control.sock
allowlist=$config_dir/allowlist
denylist=$config_dir/denylist
installed_app=/Applications/AgentCurtain.app

usage() {
  print -u2 'usage: curtain {on [seconds] [--allow-marker]|off|status|doctor|allow|deny}'
}

prepare_config() {
  mkdir -p "$state_dir" "$config_dir"
  chmod 700 "$state_dir" "$config_dir"
  if [[ ! -f "$allowlist" ]]; then
    print -r -- '# One executable path or exact process name per line.' > "$allowlist"
    chmod 600 "$allowlist"
  fi
  if [[ ! -f "$denylist" ]]; then
    {
      print -r -- '# Deny rules win over allow rules.'
      print -r -- '/Library/Application Support/org.pqrs/Karabiner-Elements/Karabiner-Core-Service.app'
      print -r -- '/Library/Application Support/org.pqrs/Karabiner-DriverKit-VirtualHIDDevice/Applications/Karabiner-VirtualHIDDevice-Daemon.app'
      print -r -- 'org.pqrs.Karabiner-DriverKit-VirtualHIDDevice'
    } > "$denylist"
    chmod 600 "$denylist"
  fi
}

send_command() {
  local command=$1
  if [[ ! -S "$socket_path" && -d "$installed_app" ]]; then
    /usr/bin/open -g "$installed_app" >/dev/null 2>&1 || true
  fi
  python3 -c 'import socket,sys,time
path,command=sys.argv[1],sys.argv[2]
last=None
for _ in range(50):
    try:
        s=socket.socket(socket.AF_UNIX); s.settimeout(45); s.connect(path); break
    except OSError as e:
        last=e; time.sleep(.1)
else:
    raise SystemExit(f"AgentCurtain control socket unavailable: {last}")
s.sendall((command+"\n").encode()); s.shutdown(socket.SHUT_WR)
chunks=[]
while True:
    data=s.recv(4096)
    if not data: break
    chunks.append(data)
response=b"".join(chunks).decode().strip()
print(response)
raise SystemExit(0 if "\"ok\":true" in response else 1)' "$socket_path" "$command"
}

prepare_config
case "${1:-status}" in
  on)
    shift
    command='on'
    for argument in "$@"; do command="$command $argument"; done
    send_command "$command"
    ;;
  off|status)
    (( $# == 1 )) || { usage; exit 2; }
    send_command "$1"
    ;;
  allow)
    (( $# == 1 )) || { usage; exit 2; }
    "${EDITOR:-vi}" "$allowlist"
    send_command reload >/dev/null
    ;;
  deny)
    (( $# == 1 )) || { usage; exit 2; }
    "${EDITOR:-vi}" "$denylist"
    send_command reload >/dev/null
    ;;
  doctor)
    (( $# == 1 )) || { usage; exit 2; }
    [[ -d "$installed_app" ]] || { print -u2 "[fail] missing $installed_app"; exit 1; }
    codesign --verify --deep --strict --verbose=2 "$installed_app"
    requirement=$(codesign -d -r- "$installed_app" 2>&1)
    [[ "$requirement" == *'anchor apple generic'* && "$requirement" != *cdhash* ]] || {
      print -u2 '[fail] designated requirement is not stable Developer ID form'; exit 1
    }
    command -v betterdisplaycli >/dev/null || { print -u2 '[fail] betterdisplaycli missing'; exit 1; }
    betterdisplay_pro=$(betterdisplaycli get -proAvailable 2>/dev/null || true)
    if [[ -z "$betterdisplay_pro" && -d /Applications/BetterDisplay.app ]]; then
      /usr/bin/open -gj /Applications/BetterDisplay.app >/dev/null 2>&1 || true
      for _ in {1..20}; do
        sleep 0.25
        betterdisplay_pro=$(betterdisplaycli get -proAvailable 2>/dev/null || true)
        [[ -n "$betterdisplay_pro" ]] && break
      done
    fi
    private_display_spi=unsupported-architecture
    if [[ "$(uname -m)" == arm64 ]]; then
      if python3 -c 'import ctypes
core_graphics=ctypes.CDLL("/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics")
getattr(core_graphics, "CGSConfigureDisplayEnabled")' >/dev/null 2>&1; then
        private_display_spi=available
      else
        private_display_spi=missing
      fi
    fi
    print "[info] privateDisplaySPI=$private_display_spi"
    print "[info] betterDisplayPro=${betterdisplay_pro:-unknown}"
    if [[ "$private_display_spi" != available && "$betterdisplay_pro" != on ]]; then
      print -u2 '[fail] no display connection backend is available'; exit 1
    fi
    # betterdisplaycli 在 BetterDisplay.app 不在时什么都不回、退出码还是 0 ——
    # 2026-09-06 重启后就是这样静默失败的。app 现在会在需要时自己拉它,
    # 但 doctor 应该把这件事说出来。
    if pgrep -xq BetterDisplay; then
      print '[ok] BetterDisplay.app is running'
    else
      print '[warn] BetterDisplay.app is not running; curtain on will launch it'
    fi
    response=$(send_command status)
    permissions=$(stat -f '%Lp' "$socket_path")
    [[ "$permissions" == 600 ]] || { print -u2 "[fail] socket mode is $permissions"; exit 1; }
    print '[ok] Developer ID requirement has no cdhash'
    print '[ok] control socket mode is 0600'
    print -r -- "$response"
    ;;
  *) usage; exit 2 ;;
esac
