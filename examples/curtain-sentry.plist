<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- curtain-sentry template. The build script supplies HOME and the selected Label.
     It keeps the existing five-minute observation schedule and does not start the app. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__SENTRY_LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/libexec/curtain-sentry</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/.local/state/curtain/sentry.out</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local/state/curtain/sentry.out</string>
</dict>
</plist>
